<% layout("layouts/boilerplate") %>
<body>
    <h1>All Listings</h1>
    <form method="get" action="/listings/new">
    </form>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1"><% for(let listing of allListings) {%>
        <div class="col">
        <a href="/listings/<%= listing._id %>">
                <img 
                    src="<%= listing.image.url %>" 
                    class="card-img-top" 
                    alt="listing_image"
                    style="height: 20rem; width: 100%; object-fit: cover;">
                </a>
                <div class="card-body">...</div>
            
    

    <div class="card-body">

    
    </div> <p class="card-text">
    <b><%= listing.title %></b>
    <br>
    <%= listing.price?.toLocaleString() || "N/A" %>/night
</p>
</div>
<% } %>
</div>


</body>



